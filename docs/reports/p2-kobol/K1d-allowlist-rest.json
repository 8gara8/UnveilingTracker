  "eutils_types": {
    "esummary_pubmed": {
      "request": "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esummary.fcgi?db=pubmed&retmode=json&id=<pmid>",
      "field": "result.<pmid>.pubtype (an array), also result.<pmid>.articleids[] where idtype \"pmc\" gives the PMC id",
      "seen": {
        "research": [
          "Journal Article"
        ],
        "review": [
          "Journal Article",
          "Review"
        ],
        "editorial": [
          "Editorial"
        ],
        "news": [
          "News"
        ],
        "comment": [
          "Journal Article",
          "Comment"
        ]
      }
    },
    "efetch_pmc": {
      "request": "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi?db=pmc&id=<pmc number without PMC>",
      "field": "the article-type attribute of the root <article> element (JATS)",
      "seen": [
        "research-article",
        "review-article",
        "editorial",
        "news",
        "article-commentary"
      ],
      "note": "one request can take several ids; the answer is JATS XML with full text, so cap the body or ask for one id at a time"
    },
    "refused_pubtypes_check": "PubMed: News, Editorial, Comment are the exact pubtype strings (Newspaper Article and Interview exist in PubMed's list too); PMC: news, editorial, article-commentary are the exact article-type values; interview is a JATS value as well",
    "sample": "samples/eutils-types.json"
  }
}
