{
  "name": "unveilingtracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node -e \"const f=require('node:fs'),c=require('node:crypto');f.writeFileSync('node_modules/.ut-lock-sha',c.createHash('sha256').update(f.readFileSync('package-lock.json')).digest('hex'))\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cheerio": "1.2.0",
    "rss-parser": "3.13.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=22"
  }
}
